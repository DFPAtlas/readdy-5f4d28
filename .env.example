# ============================================================
# DFP AI UAT Agent — Environment Configuration
# ============================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Only variables prefixed with VITE_PUBLIC_ are accessible in
# browser code. All others are server/build-time only.
# ============================================================

# --- Application ---
NODE_ENV=production
VITE_PUBLIC_APP_NAME=DFP UAT Agent
VITE_PUBLIC_APP_URL=http://localhost:3000
VITE_PUBLIC_DEPLOYMENT_MODE=local
VITE_PUBLIC_ENABLE_MOCK_UAT=false

# --- Public API Gateway ---
# The browser calls this base URL for all UAT API requests.
# In development, Vite proxy handles this. In production, your
# reverse proxy (nginx/caddy) routes /api/uat/* to the gateway.
VITE_PUBLIC_UAT_API_BASE_URL=/api/uat

# --- Optional public realtime endpoint ---
VITE_PUBLIC_UAT_REALTIME_URL=

# --- Server-only n8n settings (NEVER exposed to browser) ---
N8N_INTERNAL_URL=http://n8n:5678
N8N_UAT_WEBHOOK_PATH=/webhook/dfp-uat
N8N_UAT_CALLBACK_PATH=/webhook/dfp-uat-result
N8N_API_TOKEN=

# --- Browser worker (server-only) ---
PLAYWRIGHT_WORKER_URL=http://playwright-worker:3100
PLAYWRIGHT_WORKER_TOKEN=replace-with-long-random-token

# --- AI provider (server-only) ---
AI_PROVIDER=ollama

# --- Server-only Ollama connection (never exposed to browser) ---
# Atlas-HaL is the local AI server on the private LAN
OLLAMA_BASE_URL=http://192.168.1.92:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_REQUEST_TIMEOUT_MS=120000
OLLAMA_HEALTH_TIMEOUT_MS=5000

# Optional model behaviour
OLLAMA_TEMPERATURE=0.2
OLLAMA_KEEP_ALIVE=10m

# AI fallback behaviour
VITE_PUBLIC_UAT_ALLOW_AI_DISABLED_MODE=true
VITE_PUBLIC_UAT_FAIL_RUN_WHEN_AI_OFFLINE=false

# OpenAI (alternative — only if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Supabase ---
# Deployment mode: local | self_hosted | hosted | disabled
VITE_PUBLIC_SUPABASE_DEPLOYMENT_MODE=local

# Supabase API (safe for browser — anon key only)
# Local Supabase CLI defaults:
VITE_PUBLIC_SUPABASE_URL=http://localhost:54321
VITE_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only Supabase credentials (NEVER exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_STUDIO_URL=http://localhost:54323

# Storage buckets
VITE_PUBLIC_UAT_EVIDENCE_BUCKET=uat-evidence
VITE_PUBLIC_UAT_REPORT_BUCKET=uat-reports
VITE_PUBLIC_UAT_TRACE_BUCKET=uat-traces

# Realtime
VITE_PUBLIC_ENABLE_UAT_REALTIME=true

# Database behaviour
VITE_PUBLIC_UAT_DATABASE_REQUIRED=false
VITE_PUBLIC_UAT_DATABASE_TIMEOUT_MS=10000
VITE_PUBLIC_UAT_AUTO_RUN_MIGRATIONS=false
VITE_PUBLIC_UAT_ALLOW_DATABASE_RESET=false

# --- Security ---
VITE_PUBLIC_UAT_ALLOWED_DOMAINS=
VITE_PUBLIC_UAT_BLOCKED_DOMAINS=
VITE_PUBLIC_UAT_ALLOW_PRODUCTION_TESTING=false
VITE_PUBLIC_UAT_REQUIRE_PRODUCTION_APPROVAL=true
VITE_PUBLIC_UAT_MASK_SENSITIVE_VALUES=true

# --- Internal service authentication (server-only, NEVER exposed to browser) ---
# Generate with: openssl rand -hex 32
# Use DIFFERENT values for each secret.
UAT_WEBHOOK_SECRET=replace-with-long-random-secret
UAT_CALLBACK_SECRET=replace-with-different-long-random-secret

# Optional secret rotation (remove when not rotating)
# UAT_WEBHOOK_PREVIOUS_SECRET=
# UAT_CALLBACK_PREVIOUS_SECRET=
# PLAYWRIGHT_WORKER_PREVIOUS_TOKEN=

# --- Request signing ---
UAT_SIGNATURE_VERSION=v1
UAT_SIGNATURE_TOLERANCE_SECONDS=300
UAT_IDEMPOTENCY_TTL_HOURS=24

# --- Runtime limits ---
VITE_PUBLIC_UAT_DEFAULT_MAX_PAGES=50
VITE_PUBLIC_UAT_DEFAULT_MAX_ACTIONS=250
VITE_PUBLIC_UAT_REQUEST_TIMEOUT_MS=30000
VITE_PUBLIC_UAT_POLL_INTERVAL_MS=3000

# --- Evidence Retention & Storage ---
UAT_SUCCESS_EVIDENCE_RETENTION_DAYS=14
UAT_FAILED_EVIDENCE_RETENTION_DAYS=90
UAT_TRACE_RETENTION_DAYS=30
UAT_VIDEO_RETENTION_DAYS=30
UAT_REPORT_RETENTION_DAYS=365
UAT_TEMP_FILE_RETENTION_HOURS=24

# Storage limits
UAT_MAX_EVIDENCE_STORAGE_GB=100
UAT_STORAGE_WARNING_PERCENT=75
UAT_STORAGE_CRITICAL_PERCENT=90
UAT_MAX_SCREENSHOT_MB=10
UAT_MAX_VIDEO_MB=250
UAT_MAX_TRACE_MB=250
UAT_MAX_REPORT_MB=25

# Cleanup
UAT_CLEANUP_ENABLED=true
UAT_CLEANUP_BATCH_SIZE=100
UAT_CLEANUP_SCAN_INTERVAL_HOURS=6
UAT_CLEANUP_GRACE_PERIOD_HOURS=24
UAT_CLEANUP_DRY_RUN_DEFAULT=true

# Safety
UAT_REQUIRE_CLEANUP_APPROVAL_ABOVE_GB=10
UAT_PRESERVE_OPEN_BUG_EVIDENCE=true
UAT_PRESERVE_APPROVED_RELEASE_EVIDENCE=true

# --- Heartbeat & Recovery (server-only) ---
UAT_WORKER_HEARTBEAT_INTERVAL_SECONDS=30
UAT_WORKER_DELAYED_AFTER_SECONDS=90
UAT_WORKER_STALE_AFTER_SECONDS=180
UAT_RUN_START_TIMEOUT_SECONDS=300
UAT_RUN_IDLE_TIMEOUT_SECONDS=600
UAT_QUEUE_TIMEOUT_SECONDS=900
UAT_RECOVERY_SCAN_INTERVAL_SECONDS=60
UAT_DEFAULT_MAX_ATTEMPTS=2
UAT_CANCEL_TIMEOUT_SECONDS=120
UAT_ALERT_COOLDOWN_MINUTES=30

# --- Emergency stop ---
VITE_PUBLIC_UAT_EXECUTION_PAUSED=false

# --- Backup & Disaster Recovery ---
UAT_BACKUP_ROOT=/var/backups/dfp-uat
UAT_BACKUP_REMOTE_PATH=/mnt/atlas-vault/dfp-uat
UAT_BACKUP_ENCRYPTION_ENABLED=true
UAT_BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/uat_backup_key

# Backup schedule
UAT_DATABASE_BACKUP_INTERVAL_HOURS=24
UAT_STORAGE_BACKUP_INTERVAL_HOURS=24
UAT_CONFIG_BACKUP_INTERVAL_HOURS=24
UAT_FULL_BACKUP_INTERVAL_DAYS=7

# Retention
UAT_BACKUP_DAILY_RETENTION=7
UAT_BACKUP_WEEKLY_RETENTION=4
UAT_BACKUP_MONTHLY_RETENTION=3

# Verification
UAT_BACKUP_VERIFY_ENABLED=true
UAT_BACKUP_VERIFY_CHECKSUM=true
UAT_BACKUP_VERIFY_ARCHIVE=true
UAT_RESTORE_TEST_INTERVAL_DAYS=30

# Alerts
UAT_BACKUP_WARNING_AFTER_HOURS=30
UAT_BACKUP_CRITICAL_AFTER_HOURS=48

# RPO/RTO targets
UAT_TARGET_RPO_HOURS=24
UAT_TARGET_RTO_HOURS=4

# --- Release Governance ---
UAT_REQUIRE_SEPARATE_APPROVER=true
UAT_APPROVAL_EXPIRY_HOURS=72
UAT_REQUIRE_SECOND_APPROVER_FOR_RISK=true
UAT_ALLOW_HIGH_RISK_ACCEPTANCE=true
UAT_ALLOW_CRITICAL_RISK_ACCEPTANCE=false

# --- Release Webhook Dispatch ---
# Signed webhook to notify deployment systems on approval/rejection.
# Uses HMAC-SHA256 signing (UAT_WEBHOOK_SECRET above).
# The endpoint receives a JSON payload with build reference, Git SHA,
# approval metadata, and conditions. Never includes credentials.
UAT_RELEASE_WEBHOOK_ENABLED=true
UAT_RELEASE_WEBHOOK_ENDPOINT_URL=https://deploy.digitalfootprint.co.uk
UAT_RELEASE_WEBHOOK_PATH=/webhook/dfp-uat/release-approved
UAT_RELEASE_WEBHOOK_TIMEOUT_MS=15000
UAT_RELEASE_WEBHOOK_MAX_RETRIES=3
UAT_RELEASE_WEBHOOK_RETRY_BACKOFF_MS=5000